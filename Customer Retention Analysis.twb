      <aliases enabled='yes' />
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_2261569158615040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [churned] = &apos;t&apos; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Revenue Lost' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Calculation_2261569158832129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [churned] = &apos;t&apos; THEN [total_spend] END)' />
      </column>
      <column caption='Churn Status' datatype='string' name='[Calculation_2261569502859266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [churned] = &apos;t&apos; THEN &apos;Churned&apos; ELSE &apos;Stayed&apos; END' />
      </column>
